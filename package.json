{
  "name": "ja-event-production",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-sites.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "studio:dev": "sanity dev",
    "studio:build": "sanity build .sanity/studio-dist",
    "cms:schema": "sanity schema extract --enforce-required-fields --force --path sanity/schema.json",
    "cms:typegen": "sanity typegen generate",
    "cms:generate": "npm run cms:schema && npm run cms:typegen",
    "cms:check": "npm run cms:generate && git diff --exit-code -- sanity/schema.json src/content/sanity/generated.ts"
  },
  "dependencies": {
    "@sanity/client": "8.2.0",
    "@sanity/image-url": "2.1.1",
    "groq": "6.10.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "sanity": "6.10.1",
    "styled-components": "6.5.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
