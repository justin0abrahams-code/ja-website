# Public values embedded into the generated static site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_QUOTE_FORM_ENDPOINT=
NEXT_PUBLIC_SITE_URL=

# Build-time content source. Leave as fixture for local/offline builds.
JA_CONTENT_SOURCE=fixture

# Public Sanity identifiers used by the standalone Studio and server-side build.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Optional server-only read token for private datasets. Never use NEXT_PUBLIC_*.
SANITY_READ_TOKEN=
